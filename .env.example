# Next.js Environment Variables
# Copy this file to .env.local for development

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# TMDB API Configuration
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# Brand Configuration (can be overridden by domain)
NEXT_PUBLIC_DEFAULT_BRAND=popcorn

# Analytics Configuration
NEXT_PUBLIC_GA_TRACKING_ID=your_google_analytics_id
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Streaming Configuration
NEXT_PUBLIC_DEFAULT_STREAMING_PROVIDER=cinemaos
NEXT_PUBLIC_STREAMING_QUALITY=1080p

# Security Configuration
NEXT_PUBLIC_ENABLE_CORS=true

# PWA Configuration
NEXT_PUBLIC_PWA_ENABLED=true

# Cache Configuration
NEXT_PUBLIC_CACHE_TTL=86400
NEXT_PUBLIC_IMAGE_CACHE_TTL=3600

# AI/SEO Configuration
NEXT_PUBLIC_ENABLE_AI_SEO=true